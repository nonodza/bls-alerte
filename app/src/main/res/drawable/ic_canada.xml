<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Smaller circular badge -->
    <path
        android:pathData="M50,13 A37,37 0,1 1,49.9,13 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="35"
                android:centerY="27"
                android:gradientRadius="75">
                <item android:color="#FFFFFF" android:offset="0" />
                <item android:color="#F2F2F2" android:offset="0.45" />
                <item android:color="#B8B8B8" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Clip the flag to the circle -->
    <group>
        <clip-path
            android:pathData="M50,13 A37,37 0,1 1,49.9,13 Z" />

        <!-- Red flag field -->
        <path android:pathData="M10,10 H90 V90 H10 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="18"
                    android:startY="15"
                    android:endX="83"
                    android:endY="88"
                    android:type="linear">
                    <item android:color="#FF4B55" android:offset="0" />
                    <item android:color="#D80020" android:offset="0.48" />
                    <item android:color="#790015" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- White center panel -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M32,10 H68 V90 H32 Z" />

        <!-- Maple leaf with shaded red gradient (تم تصحيح المسار بالكامل هنا) -->
        <path
            android:pathData="M50,26 
                       L52.8,36.5 L47.5,38.6 L49,33 
                       L42,33 L44.8,27.4 L40.6,26 L44.8,21.1 L39.9,16.2 L47.6,18.3 L49.7,11.3 
                       L53.9,14.8 L58.1,11.3 L60.2,18.3 L67.9,16.2 L63,21.1 L67.2,26 L63,27.4 L65.8,33 
                       L58.8,33 L60.3,38.6 L55,36.5 L57.8,26 
                       L53.4,26 L54.5,41.9 L52.4,43.3 L51.4,56 
                       L48.6,56 L47.6,43.3 L45.5,41.9 L46.6,26 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="37"
                    android:startY="29"
                    android:endX="63"
                    android:endY="68"
                    android:type="linear">
                    <item android:color="#FF4555" android:offset="0" />
                    <item android:color="#D00020" android:offset="0.55" />
                    <item android:color="#870015" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Subtle highlight on the leaf (تم تعديله ليتطابق مع النصف الأيسر للورقة الجديدة) -->
        <path
            android:fillColor="#33FFFFFF"
            android:pathData="M50,12 L47.6,18.3 L39.9,16.2 L44.8,21.1 L40.6,26 L44.8,27.4 L42,33 L49,33 L47.5,38.6 L52.8,36.5 L50,26 L46.6,26 L45.5,41.9 L47.6,43.3 L48.6,56 L50,56 Z" />
    </group>

</vector>
