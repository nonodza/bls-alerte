<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://android.com"
    xmlns:aapt="http://android.com"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Smaller circular badge -->
    <path
        android:pathData="M50,13 A37,37 0,1 1,49.9,13 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="35"
                android:centerY="27"
                android:gradientRadius="75">
                <item android:color="#FFFFFF" android:offset="0" />
                <item android:color="#F2F2F2" android:offset="0.45" />
                <item android:color="#B8B8B8" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Clip the flag to the circle -->
    <group>
        <clip-path
            android:pathData="M50,13 A37,37 0,1 1,49.9,13 Z" />

        <!-- Red flag field -->
        <path android:pathData="M10,10 H90 V90 H10 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="18"
                    android:startY="15"
                    android:endX="83"
                    android:endY="88"
                    android:type="linear">
                    <item android:color="#FF4B55" android:offset="0" />
                    <item android:color="#D80020" android:offset="0.48" />
                    <item android:color="#790015" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- White center panel -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M32,10 H68 V90 H32 Z" />

        <!-- Maple leaf with shaded red gradient (مسار ورقة القيقب الرسمية الحقيقية بدقة 100%) -->
        <path
            android:pathData="M50,26 
                       L52,38 L44,41 L46,33 
                       L36,33 L40,25 L34,23 L40,18 L35,13 L43,15 L45,8 
                       L50,13 L55,8 L57,15 L65,13 L60,18 L66,23 L60,25 L64,33 
                       L54,33 L56,41 L48,38 L50,26 
                       L51.5,52 L52.5,74 L47.5,74 L48.5,52 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="37"
                    android:startY="29"
                    android:endX="63"
                    android:endY="68"
                    android:type="linear">
                    <item android:color="#FF4555" android:offset="0" />
                    <item android:color="#D00020" android:offset="0.55" />
                    <item android:color="#870015" android:offset="1" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Subtle highlight on the leaf (تم تعديل الإضاءة لتتطابق تماماً مع نصف الورقة الحقيقية) -->
        <path
            android:fillColor="#33FFFFFF"
            android:pathData="M50,13 L45,8 L43,15 L35,13 L40,18 L34,23 L40,25 L36,33 L46,33 L44,41 L52,38 L50,26 L48.5,52 L47.5,74 L50,74 Z" />
    </group>

</vector>
