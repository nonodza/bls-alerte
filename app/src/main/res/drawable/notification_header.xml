<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="66dp"
    android:orientation="vertical"
    android:background="@drawable/notification_header_bg"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">


    <!-- ================================================= -->
    <!-- TOP ROW                                           -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="31dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">


        <!-- RV -->
        <TextView
            android:id="@+id/notification_rv"
            android:layout_width="34dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:text="RV"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/notification_rv_bg" />


        <!-- TITLE -->
        <TextView
            android:id="@+id/notification_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:text="BLS Rendez-Vous"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="none" />

    </LinearLayout>


    <!-- ================================================= -->
    <!-- MONITORING STATUS + STOP                          -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="27dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">


        <!-- SHIELD -->
        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:src="@drawable/ic_monitoring_shield"
            android:contentDescription="@null" />


        <!-- STATUS -->
        <TextView
            android:id="@+id/notification_description"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center_vertical"
            android:text="Monitoring is active"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="none" />


        <!-- STOP -->
        <TextView
            android:id="@+id/notification_stop"
            android:layout_width="72dp"
            android:layout_height="23dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="STOP"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/notification_stop_bg" />

    </LinearLayout>

</LinearLayout>
