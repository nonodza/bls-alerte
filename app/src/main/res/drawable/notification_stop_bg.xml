<?xml version="1.0" encoding="utf-8"?>

<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- OUTER SOFT GLOW -->
    <item>
        <shape android:shape="rectangle">

            <solid
                android:color="#66798596" />

            <corners
                android:radius="9dp" />

        </shape>
    </item>

    <!-- SECOND LIGHT LAYER -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">

        <shape android:shape="rectangle">

            <solid
                android:color="#D5DAE3" />

            <corners
                android:radius="8dp" />

        </shape>
    </item>

    <!-- DARK INNER BUTTON -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">

        <shape android:shape="rectangle">

            <solid
                android:color="#20222C" />

            <corners
                android:radius="6dp" />

        </shape>
    </item>

</layer-list>
