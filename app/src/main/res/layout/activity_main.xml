<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_night"
    android:padding="24dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BLS Rendez-Vous"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="60dp"
        android:id="@+id/title"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_centerInParent="true"
        android:gravity="center">
        <Button
            android:id="@+id/btnAlerte"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_button_glass"
            android:text="BLS ALERTE"
            android:textColor="#2D2A8A"
            android:textStyle="bold"/>
        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_button_glass"
            android:text="BLS START"
            android:textColor="#2D2A8A"
            android:textStyle="bold"/>
        <Button
            android:id="@+id/btnRdv"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_button_glass"
            android:text="BLS RENDEZ-VOUS"
            android:textColor="#2D2A8A"
            android:textStyle="bold"/>
    </LinearLayout>
</RelativeLayout>
