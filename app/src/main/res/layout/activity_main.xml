<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1931">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
<androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="16dp" app:cardBackgroundColor="#112240">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<TextView android:id="@+id/btn_menu" android:layout_width="40dp" android:layout_height="40dp" android:text="☰" android:textColor="#00E5FF" android:textSize="22sp" android:gravity="center"/>
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="BLS" android:textSize="42sp" android:textStyle="bold" android:textColor="white"/>
<TextView android:layout_width="wrap_content" android:layout_height="24dp" android:text=" PRO " android:textColor="#000" android:background="#FFC93C" android:gravity="center" android:paddingHorizontal="8dp" android:textStyle="bold"/>
</LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Prendre Rendez-Vous" android:textSize="13sp" android:textColor="#6FA8DC" android:layout_marginStart="40dp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Visa Espagne Alger - Oran" android:textSize="10sp" android:textColor="#3A5A7E" android:layout_marginStart="40dp" android:layout_marginTop="4dp"/>
</LinearLayout>
</androidx.cardview.widget.CardView>
<GridLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:columnCount="2" android:rowCount="2" android:layout_marginTop="10dp">
<androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="6dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#162B4D"><LinearLayout android:id="@+id/btn_alerte" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BLS Alerte" android:textColor="white" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Alerte RDV" android:textColor="#6A8CB0" android:textSize="10sp"/></LinearLayout></androidx.cardview.widget.CardView>
<androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="6dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#162B4D"><LinearLayout android:id="@+id/btn_rdv" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rendez-Vous" android:textColor="white" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Prendre RDV" android:textColor="#6A8CB0" android:textSize="10sp"/></LinearLayout></androidx.cardview.widget.CardView>
<androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="6dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#162B4D"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Documents" android:textColor="white" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Liste" android:textColor="#6A8CB0" android:textSize="10sp"/></LinearLayout></androidx.cardview.widget.CardView>
<androidx.cardview.widget.CardView android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="6dp" app:cardCornerRadius="14dp" app:cardBackgroundColor="#162B4D"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Suivi" android:textColor="white" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dossier" android:textColor="#6A8CB0" android:textSize="10sp"/></LinearLayout></androidx.cardview.widget.CardView>
</GridLayout>
</LinearLayout>
<LinearLayout android:layout_width="260dp" android:layout_height="match_parent" android:layout_gravity="start" android:background="#111E36" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BLS&#10;Prendre Rendez-Vous" android:textColor="white" android:textSize="18sp"/>
<TextView android:id="@+id/link_youtube" android:layout_width="match_parent" android:layout_height="50dp" android:text="▶ YouTube" android:textColor="white" android:gravity="center_vertical" android:layout_marginTop="20dp"/>
<TextView android:id="@+id/link_facebook" android:layout_width="match_parent" android:layout_height="50dp" android:text="f Facebook" android:textColor="white" android:gravity="center_vertical"/>
<TextView android:id="@+id/link_instagram" android:layout_width="match_parent" android:layout_height="50dp" android:text="◎ Instagram" android:textColor="white" android:gravity="center_vertical"/>
</LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
