
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:orientation="vertical"
    android:background="@drawable/notification_header_bg"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notification_rv"
            android:layout_width="32dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:text="RV"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/notification_rv_bg" />

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="7dp"
            android:gravity="center_vertical"
            android:text="BLS Rendez-Vous"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:src="@drawable/ic_monitoring_shield"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/notification_description"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="6dp"
            android:gravity="center_vertical"
            android:text="Checking BLS website..."
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/notification_info"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center_vertical"
        android:text="MANUAL CHECK • IN PROGRESS"
        android:textColor="#D9F8FF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:maxLines="1" />

</LinearLayout>
