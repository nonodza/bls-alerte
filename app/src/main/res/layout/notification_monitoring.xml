<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:orientation="vertical"
    android:background="@drawable/notification_header_bg"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <!-- TOP ROW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- RV -->
        <TextView
            android:id="@+id/notification_rv"
            android:layout_width="30dp"
            android:layout_height="22dp"
            android:gravity="center"
            android:text="RV"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/notification_rv_bg" />

        <!-- TITLE -->
        <TextView
            android:id="@+id/notification_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="7dp"
            android:gravity="center_vertical"
            android:text="BLS Rendez-Vous"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1" />

    </LinearLayout>


    <!-- MONITORING STATUS + QUITTER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- SHIELD -->
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_monitoring_shield"
            android:contentDescription="@null" />

        <!-- STATUS -->
        <TextView
            android:id="@+id/notification_description"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="6dp"
            android:gravity="center_vertical"
            android:text="Monitoring is active"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:maxLines="1" />

        <!-- QUITTER -->
        <LinearLayout
            android:id="@+id/btnQuitter"
            android:layout_width="105dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_btn_quitter"
            android:clickable="true"
            android:focusable="true">

            <!-- LOGOUT ICON -->
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_logout"
                android:contentDescription="@null" />

            <!-- QUITTER TEXT -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Quitter"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>


    <!-- MONITORING INFORMATION -->
    <TextView
        android:id="@+id/notification_info"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:gravity="center_vertical"
        android:text="Last check: --:--:--  •  Checked: 0 times"
        android:textColor="#B8C0D4"
        android:textSize="10sp"
        android:maxLines="1" />

</LinearLayout>
