<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#151A2A">

    <!-- ================================================= -->
    <!-- HEADER -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/notification_header_bg">

        <!-- BLS ICON -->

        <ImageView
            android:id="@+id/notification_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:background="#1E4FFF"
            android:src="@drawable/ic_bls_notification"
            android:scaleType="centerInside" />

        <!-- TITLE -->

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:text="BLS Rendez-Vous"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center_vertical" />

        <!-- ARROW -->

        <TextView
            android:id="@+id/notification_expand"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="∨"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:gravity="center"
            android:alpha="0.85" />

    </LinearLayout>


    <!-- ================================================= -->
    <!-- BODY -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="#151A2A">


        <!-- ACTIVE STATUS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- GREEN DOT -->

            <TextView
                android:id="@+id/notification_live"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:text="●"
                android:textColor="#4ADE80"
                android:textSize="16sp"
                android:gravity="center" />


            <!-- STATUS -->

            <TextView
                android:id="@+id/notification_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="Monitoring is active"
                android:textColor="#4ADE80"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- DESCRIPTION -->

        <TextView
            android:id="@+id/notification_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Scanning BLS Spain - Algiers center"
            android:textColor="#A7A7AC"
            android:textSize="12sp"
            android:maxLines="2" />


        <!-- DIVIDER -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="11dp"
            android:layout_marginBottom="10dp"
            android:background="#35394A" />


        <!-- ================================================= -->
        <!-- ACTIONS -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">


            <!-- STOP -->

            <TextView
                android:id="@+id/notification_stop"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginRight="5dp"
                android:gravity="center"
                android:text="STOP"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="#292D3D" />


            <!-- VIEW LOG -->

            <TextView
                android:id="@+id/notification_log"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginLeft="5dp"
                android:gravity="center"
                android:text="VIEW LOG"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="#246BFE" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
